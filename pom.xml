<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.zheng</groupId>
    <artifactId>fish-agent</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>Fish-Agent</name>
    <description>轻量、可扩展的 Java Agent 框架，原生对接 Ollama 本地大模型，支持工具调用、记忆、流式输出与 ReAct</description>
    <url>https://github.com/zheng/fish-agent</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>zheng</id>
            <name>zheng</name>
        </developer>
    </developers>

    <organization>
        <name>Fish-Agent</name>
        <url>https://github.com/zheng/fish-agent</url>
    </organization>

    <scm>
        <connection>scm:git:https://github.com/zheng/fish-agent.git</connection>
        <developerConnection>scm:git:ssh://github.com/zheng/fish-agent.git</developerConnection>
        <url>https://github.com/zheng/fish-agent</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <!--
            编译目标锁定 JDK 21（LTS），以获得最广的使用者兼容面。
            注意：该属性是使用者的「运行时最低门槛」。JDK 25 的运行时红利
            （JEP 491 虚拟线程去 pinning、JEP 519 紧凑对象头、JEP 483 AOT 启动加速）
            均由 JVM 提供，与编译目标无关——使用者在 JDK 25 上运行本 SDK 即可自动获得。
        -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <jackson.version>2.18.2</jackson.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencies>
        <!-- 仅用于 JSON 编解码，框架其余部分只依赖 JDK 自带的 java.net.http -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <!-- 源码为 UTF-8，显式声明以避免在 GBK 默认环境下中文乱码 -->
                    <encoding>UTF-8</encoding>
                    <compilerArgs>
                        <arg>-parameters</arg>
                        <arg>-encoding</arg>
                        <arg>UTF-8</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Implementation-Title>${project.name}</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                            <Implementation-Vendor>${project.organization.name}</Implementation-Vendor>
                            <Automatic-Module-Name>com.zheng.fishagent</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- 随包发布源码，方便使用者调试与阅读 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- 随包发布 Javadoc -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <charset>UTF-8</charset>
                    <docencoding>UTF-8</docencoding>
                    <!--
                        背景：Windows 上若 JAVA_TOOL_OPTIONS 设置了 -Dfile.encoding=GBK（IDEA 常见配置），
                        fork 出的 javadoc 子进程会以 GBK 解码 UTF-8 源码，产生大批
                        "unmappable character" 报错。

                        为什么用 additionalJOption 而不是 additionalOptions：
                          - additionalOptions 会被写入 @options 参数文件（XML 格式），
                            javadoc 不读取其中的 -encoding，参数等于丢失；
                          - additionalJOption 生成 -J 前缀的 JVM 参数，直接出现在命令行，
                            -Dfile.encoding 会覆盖环境变量 JAVA_TOOL_OPTIONS，从而根治该问题。
                    -->
                    <additionalJOption>-J-Dfile.encoding=UTF-8</additionalJOption>
                    <doclint>none</doclint>
                    <quiet>true</quiet>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- 便于直接运行示例：mvn exec:java （可通过 -Dexec.args 传参） -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>com.zheng.fishagent.example.ConsoleChat</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            发布到 Maven Central 时启用：mvn -Prelease clean deploy
            需在 ~/.m2/settings.xml 中配置 id 为 central 的服务器账号，
            并准备好 GPG 密钥。
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
